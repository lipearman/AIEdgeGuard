# edge-ai .env — copy to .env and fill in real values

# Ollama on the llm-server HOST (systemd service, default port 11434)
OLLAMA_URL=http://host.docker.internal:11434
# Test with any model you already have; production target: qwen3.5:9b
# Pull first on the host:  ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b

# CrowdSec LAPI (inside edge_net)
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_MACHINE_ID=edge-ai
CROWDSEC_MACHINE_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
# Read-only bouncer for listing decisions:
#   docker compose exec crowdsec cscli bouncers add edge-ai-readonly -o raw
CROWDSEC_BOUNCER_KEY=

# Data plane
REDIS_URL=redis://redis:6379/0

# Safety switch — automated blocking stays OFF until Policy Engine is built
DEFENSE_ENABLED=false
