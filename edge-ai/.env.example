# edge-ai .env — copy to .env and fill in real values (DO NOT COMMIT .env)

# --- AI runtime ---
# Windows llm-server: Ollama runs as a host service on :11434
# (Docker Desktop containers reach it via host.docker.internal automatically)
OLLAMA_URL=http://host.docker.internal:11434
# pilot: typhoon2.5-qwen3-4b (fits remaining VRAM); upgrade path: qwen3.5:9b
OLLAMA_MODEL=hf.co/typhoon-ai/typhoon2.5-qwen3-4b-gguf:Q4_K_M

# --- CrowdSec LAPI (gateway stack, gateway_net) ---
CROWDSEC_LAPI_URL=http://crowdsec:8080
# watcher machine (push alerts/decisions):
#   docker compose exec crowdsec cscli machines add edge-ai --password "<secret>" -f -
CROWDSEC_MACHINE_ID=edge-ai
CROWDSEC_MACHINE_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
# read-only bouncer (list decisions):
#   docker compose exec crowdsec cscli bouncers add edge-ai-readonly -o raw
CROWDSEC_BOUNCER_KEY=

# --- Data plane ---
REDIS_URL=redis://redis:6379/0
# gateway stack postgres (pgvector ready): user edgeguard / db edgeguard
DATABASE_URL=postgresql://edgeguard:REPLACE_WITH_LONG_RANDOM_SECRET@gateway-postgres:5432/edgeguard

# --- Phases 5-7: detection / decision / defense ---
DETECTION_ENABLED=true
DECIDE_ENABLED=true
# dry-run (default): AI proposals execute only after HUMAN approval via
#   POST /api/v1/decisions/{id}/approve
# true = policy-approved L1 actions auto-execute (protected ranges still
#        require human approval — see api/app/policy.yaml)
DEFENSE_AUTO_EXECUTE=false

# legacy stub flag (superseded by the decisions workflow)
DEFENSE_ENABLED=false
