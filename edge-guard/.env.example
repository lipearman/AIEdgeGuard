# edge-guard .env — copy to .env and fill in real values
# Generate strong secrets: openssl rand -base64 32

# PostgreSQL
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# CrowdSec LAPI credentials
# Bouncer key for Traefik plugin — generate AFTER first start:
#   docker compose exec crowdsec cscli bouncers add traefik-bouncer -o raw
#   then paste the key here and run: docker compose up -d traefik
CROWDSEC_BOUNCER_KEY=

# Machine credentials for edge-ai (read-only watcher) — generate AFTER first start:
#   docker compose exec crowdsec cscli machines add edge-ai --password "LONG_RANDOM" -o raw
#   then put username/password here (used by edge-ai/.env)
CROWDSEC_MACHINE_ID=edge-ai
CROWDSEC_MACHINE_PASSWORD=

# Public hostname used by CrowdSec (LAPI advertised URL) — keep internal
LOCAL_API_URL=http://crowdsec:8080
