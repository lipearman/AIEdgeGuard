# EdgeGuard Gateway .env — copy to .env and fill in (DO NOT COMMIT .env)
# Live deployment location on llm-server: C:\Docker\gateway\

# PostgreSQL (incident/policy storage, used by later phases)
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET

# Bouncer key for Traefik plugin — generate AFTER first start:
#   docker compose exec crowdsec cscli bouncers add traefik-bouncer -o raw
CROWDSEC_BOUNCER_KEY=

# edge-ai watcher credentials — generate AFTER first start:
#   docker compose exec crowdsec cscli machines add edge-ai --password "<secret>" -o raw
CROWDSEC_MACHINE_ID=edge-ai
CROWDSEC_MACHINE_PASSWORD=
